# Rename this file to `.env.example`, then copy to `.env` and fill in.
# (It ships without the leading dot only because of a local tooling restriction.)
# `.env` is gitignored; `.env.example` should be committed.

# Anthropic API key for the classification layer
ANTHROPIC_API_KEY=sk-ant-...

# SEC requires a descriptive User-Agent with a real contact address on every request.
# Requests without one are throttled or blocked. Format: "Name email@domain.com"
# KEEP THE QUOTES — the value contains spaces, and `source .env` will try to
# execute the second word as a command without them.
SEC_USER_AGENT="Adrien Kamdem kamdemadrien@gmail.com"

# Optional — only if you buy a transcript API (see docs/sources_log.csv)
FMP_API_KEY=
